# ---------------------------------------------------------------------------
# ZbxDeploy configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Port the web UI listens on (host side)
APP_PORT=8080

# Set to true only while developing: it shows stack traces in the browser.
APP_DEBUG=false

# Encryption key for SSH keys, sudo passwords and Zabbix API tokens.
# Generate with:  docker compose run --rm php php bin/genkey.php
# Back this up. Without it, every stored credential is unrecoverable.
APP_KEY=

# ---------------------------------------------------------------------------
# Operator login (single account for now)
# Generate the hash with:  docker compose run --rm php php bin/hash-password.php
# ---------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Set to true when ZbxDeploy is served over HTTPS (recommended).
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME_MINUTES=480

# ---------------------------------------------------------------------------
# Database (the tool's own database, not the Zabbix one it deploys)
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=zbxdeploy
DB_USER=zbxdeploy
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_POLL_SECONDS=3
JOB_STALE_MINUTES=120
ANSIBLE_VERBOSE=false

DATA_DIR=/data
