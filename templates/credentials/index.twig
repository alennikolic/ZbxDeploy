{# templates/credentials/index.twig #}
{% extends 'layout.twig' %}

{% set active = 'credentials' %}
{% block title %}Credentials · {{ app_name }}{% endblock %}

{% block content %}
    <h1>Credentials</h1>
    <p class="subtitle">
        SSH identities ZbxDeploy uses to reach your servers. Stored encrypted with APP_KEY and never shown again
        after you save them.
    </p>

    <div class="card">
        <h2>Stored credentials</h2>
        <table>
            <thead>
            <tr><th>Name</th><th>SSH user</th><th>Type</th><th>Privilege escalation</th><th>Hosts</th><th></th></tr>
            </thead>
            <tbody>
            {% for credential in credentials %}
                <tr>
                    <td>{{ credential.name }}</td>
                    <td class="mono">{{ credential.ssh_user }}</td>
                    <td><span class="badge badge-idle">{{ credential.auth_type }}</span></td>
                    <td class="mono muted">{{ credential.become_method }}</td>
                    <td class="muted">{{ credential.host_count }}</td>
                    <td style="text-align: right">
                        <form method="post" action="/credentials/{{ credential.id }}/delete" class="inline-form"
                              onsubmit="return confirm('Delete credential {{ credential.name }}?')">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">No credentials yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>Add credential</h2>
        <form method="post" action="/credentials">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="grid grid-2">
                <div class="field">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" placeholder="zbxdeploy-key" required>
                </div>
                <div class="field">
                    <label for="ssh_user">SSH user</label>
                    <input type="text" id="ssh_user" name="ssh_user" placeholder="zbxdeploy" required>
                </div>
                <div class="field">
                    <label for="auth_type">Authentication</label>
                    <select id="auth_type" name="auth_type">
                        <option value="key">SSH private key (recommended)</option>
                        <option value="password">Password</option>
                    </select>
                </div>
                <div class="field">
                    <label for="become_method">Privilege escalation</label>
                    <select id="become_method" name="become_method">
                        <option value="sudo">sudo</option>
                        <option value="none">none (already root)</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label for="secret">Private key or password</label>
                <textarea id="secret" name="secret" required
                          placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;...&#10;-----END OPENSSH PRIVATE KEY-----"></textarea>
                <div class="hint">
                    Use a key dedicated to this tool, not your personal one. Encrypted passphrases on the key itself
                    are not supported yet.
                </div>
            </div>

            <div class="field" style="max-width: 50%">
                <label for="become_password">sudo password (leave empty for NOPASSWD)</label>
                <input type="password" id="become_password" name="become_password" autocomplete="new-password">
            </div>

            <button type="submit" class="btn">Store credential</button>
        </form>
    </div>
{% endblock %}
