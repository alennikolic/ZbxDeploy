{% extends 'layout.twig' %}

{% set active = 'hosts' %}
{% block title %}{{ host.hostname }} · {{ app_name }}{% endblock %}

{% block content %}
    <h1>{{ host.hostname }}</h1>
    <p class="subtitle">{{ host.address }}:{{ host.ssh_port }} · environment {{ host.environment_name }}</p>

    <div class="card">
        <div class="card-head">
            <h2>Facts</h2>
            <div>
                <form method="post" action="/hosts/{{ host.id }}/probe" class="inline-form">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-ghost btn-sm">Probe now</button>
                </form>
            </div>
        </div>

        {% if facts is empty %}
            <p class="muted">This host has never been probed. Attach a credential and run a probe to collect its facts.</p>
        {% else %}
            <dl class="facts">
                <dt>Operating system</dt>
                <dd class="mono">{{ facts.os_family }} {{ facts.os_version }} ({{ facts.os_codename }})</dd>
                <dt>Kernel</dt>
                <dd class="mono">{{ facts.kernel ?: '—' }}</dd>
                <dt>Architecture</dt>
                <dd class="mono">{{ facts.architecture ?: '—' }}</dd>
                <dt>Timezone</dt>
                <dd class="mono">{{ facts.timezone ?: '—' }}</dd>
                <dt>Clock synchronised</dt>
                <dd>
                    {% if facts.ntp_synchronized %}
                        <span class="badge badge-ok">yes</span>
                    {% else %}
                        <span class="badge badge-warn">no — fix before deploying</span>
                    {% endif %}
                </dd>
                <dt>Memory</dt>
                <dd class="mono">{{ facts.memory_mb ? facts.memory_mb ~ ' MB' : '—' }}</dd>
                <dt>CPU cores</dt>
                <dd class="mono">{{ facts.cpu_cores ?: '—' }}</dd>
                <dt>Free space on /</dt>
                <dd class="mono">{{ facts.root_free_mb ? facts.root_free_mb ~ ' MB' : '—' }}</dd>
                <dt>Zabbix packages present</dt>
                <dd class="mono">{{ facts.zabbix_packages_installed ? 'yes — check for conflicts' : 'no' }}</dd>
                <dt>Zabbix repo candidate</dt>
                <dd class="mono">{{ facts.zabbix_agent2_candidate ?: 'none' }}</dd>
                <dt>Last probed</dt>
                <dd class="muted">{{ host.last_probe_at|ago }}</dd>
            </dl>
        {% endif %}
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Roles</h2>
            <a href="/hosts/{{ host.id }}/roles/new" class="btn btn-ghost btn-sm">Add role</a>
        </div>

        {% if roles is empty %}
            <p class="muted">No roles assigned yet. A role records what this host should run; applying is a separate step.</p>
        {% else %}
            <table>
                <thead><tr><th>Role</th><th>Status</th><th>Last applied</th><th></th></tr></thead>
                <tbody>
                {% for role in roles %}
                    <tr>
                        <td>
                            {{ catalog[role.role].label|default(role.role) }}
                            <div class="mono muted" style="font-size: 12px">{{ role.role }}</div>
                        </td>
                        <td>
                            {% if role.last_status == 'applied' %}
                                <span class="badge badge-ok">applied</span>
                            {% elseif role.last_status == 'failed' %}
                                <span class="badge badge-err">failed</span>
                            {% else %}
                                <span class="badge badge-warn">pending</span>
                            {% endif %}
                        </td>
                        <td class="muted">{{ role.applied_at|ago }}</td>
                        <td style="text-align: right">
                            <a class="btn btn-ghost btn-sm"
                               href="/hosts/{{ host.id }}/roles/new?role={{ role.role|url_encode }}">Edit</a>
                            <form method="post" action="/hosts/{{ host.id }}/roles/{{ role.id }}/delete" class="inline-form"
                                  onsubmit="return confirm('Remove this role from the plan? Nothing is uninstalled on the server.')">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <form method="post" action="/hosts/{{ host.id }}/apply" style="margin-top: 18px">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <label style="display: flex; align-items: center; gap: 8px; color: var(--text); margin-bottom: 12px">
                    <input type="checkbox" name="check_mode" value="1" checked style="width: auto">
                    <span>Dry run first (ansible --check: report what would change, change nothing)</span>
                </label>
                <button type="submit" class="btn">Apply roles</button>
            </form>
        {% endif %}
    </div>

    <div class="card">
        <h2>Recent jobs for this host</h2>
        {% include 'jobs/_table.twig' with {jobs: jobs} %}
    </div>

    <form method="post" action="/hosts/{{ host.id }}/delete" class="inline-form"
          onsubmit="return confirm('Remove {{ host.hostname }} from the inventory? Nothing is changed on the server itself.')">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <button type="submit" class="btn btn-danger btn-sm">Remove from inventory</button>
    </form>
    <a href="/hosts" class="btn btn-ghost btn-sm">Back to hosts</a>
{% endblock %}
