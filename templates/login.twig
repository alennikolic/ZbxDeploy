{# templates/login.twig #}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · {{ app_name }}</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<div class="login-wrap">
    <span class="brand">Zbx<span style="color: var(--accent)">Deploy</span></span>
    <p class="subtitle">Deploy, configure and maintain Zabbix environments.</p>

    {% for message in flash %}
        <div class="flash flash-{{ message.type }}">{{ message.message }}</div>
    {% endfor %}

    <div class="card">
        <form method="post" action="/login">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" autofocus required>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn" style="width: 100%">Sign in</button>
        </form>
    </div>
</div>
</body>
</html>
