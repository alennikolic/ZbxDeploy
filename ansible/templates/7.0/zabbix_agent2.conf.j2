{# ansible/templates/7.0/zabbix_agent2.conf.j2 #}
##############################################
# Zabbix agent 2 configuration - Zabbix {{ zbx_version }}
#
# Managed by ZbxDeploy. Do not edit this file by hand: it is rewritten from a
# template on every apply, and local changes are lost without warning.
#
# To add your own settings, drop a .conf file into:
#   {{ zbx_include_dir }}/
# Those files are read after this one and are never touched by ZbxDeploy.
##############################################

PidFile=/run/zabbix/zabbix_agent2.pid
LogFile=/var/log/zabbix/zabbix_agent2.log
LogFileSize=10
ControlSocket=/run/zabbix/agent.sock

### Option: Server
# Addresses allowed to query this agent (passive checks).
Server={{ zbx_server }}

### Option: ServerActive
{% if zbx_server_active | length > 0 %}
# Address this agent reports to for active checks.
ServerActive={{ zbx_server_active }}
{% else %}
# Active checks are disabled: no ServerActive is configured.
{% endif %}

### Option: Hostname
# Must match the host name configured in Zabbix exactly.
Hostname={{ zbx_agent_hostname }}

ListenPort={{ zbx_listen_port }}
Timeout={{ zbx_timeout }}

{% if zbx_allow_system_run %}
### Option: AllowKey
# Remote command execution is ENABLED for this host. Anyone who can reach this
# agent from an address in Server= can run arbitrary commands as the zabbix user.
AllowKey=system.run[*]
{% else %}
### Option: DenyKey
# Remote command execution is disabled.
DenyKey=system.run[*]
{% endif %}

Include={{ zbx_include_dir }}/*.conf
